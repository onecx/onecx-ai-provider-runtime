FROM ghcr.io/onecx/docker-quarkus-jvm:1.9.0

COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/
# Bundle the versioned runtime OpenAPI contract into the image so it ships with the same
# immutable image tag; consumers read it out with docker cp / kubectl cp.
COPY --chmod=644 src/main/openapi/openapi-runtime.yaml /etc/onecx/openapi-runtime.yaml
USER 185
